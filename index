<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>La fiesta del asesino</title>
<style>
:root{--bg:#0a080d;--panel:#16111d;--fg:#ece8f2;--mut:#8f879d;--acc:#d62828;--me:#2b2238;color-scheme:dark;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
html,body{height:100%;margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 system-ui,-apple-system,"Segoe UI",sans-serif}
#app{display:flex;flex-direction:column;height:100%;max-width:640px;margin:0 auto}
header{display:flex;align-items:center;gap:10px;padding:8px 14px;background:var(--panel);border-bottom:1px solid #2a2030}
#av{width:44px;height:44px;border-radius:50%;object-fit:cover;border:2px solid var(--acc)}
.nm{font-weight:700}.st{font-size:12px;color:var(--acc)}
#chip{margin-left:auto;font-size:12px;font-weight:700;padding:3px 10px;border-radius:99px;background:#333;color:#fff}
#chat{flex:1;overflow-y:auto;padding:12px;display:flex;flex-direction:column;gap:8px}
.m{max-width:86%;padding:10px 12px;border-radius:14px;white-space:pre-wrap;overflow-wrap:anywhere}
.g{background:var(--panel);align-self:flex-start;border-bottom-left-radius:4px}
.u{background:var(--me);align-self:flex-end;border-bottom-right-radius:4px}
.r{border-left:4px solid var(--acc);color:#ffb3b3;font-weight:600}
.s{align-self:center;color:var(--mut);font-size:13px;text-align:center}
.win{align-self:stretch;max-width:none;text-align:center;background:#2a0a0a;border:2px solid var(--acc);font-size:18px}
.win b{display:block;font-size:30px;color:#ff5a5a;font-variant-numeric:tabular-nums}
.call{display:flex;flex-direction:column;align-items:center;gap:10px;padding:10px 0}
.call img{width:120px;height:120px;border-radius:50%;object-fit:cover;border:3px solid var(--acc)}
.pick{display:flex;gap:10px;width:100%}
.pick button{flex:1;padding:16px 6px;border:0;border-radius:12px;color:#fff;font-size:16px;font-weight:700}
#bar{display:flex;gap:8px;padding:10px;background:var(--panel);border-top:1px solid #2a2030}
#bar input{flex:1;min-width:0;padding:12px;border-radius:10px;border:1px solid #3a3050;background:var(--bg);color:var(--fg);font-size:16px}
#bar button{padding:0 18px;border:0;border-radius:10px;background:var(--acc);color:#fff;font-weight:700;font-size:16px}
#bar[hidden]{display:none}
.gone #chat{justify-content:center}
</style>
</head>
<body>
<div id="app">
<header><img id="av" alt="" src="data:image/jpeg;base64,"><div><div class="nm">Desconocido</div><div class="st">● llamada en curso</div></div><span id="chip" hidden></span></header>
<div id="chat"></div>
<div id="bar" hidden><input id="inp" autocomplete="off" autocapitalize="off" placeholder="Escribe aquí…"><button id="go">Enviar</button></div>
</div>
<script>
/* ===== GUION Y CONTRASEÑAS ===== */
const A=x=>({rojo:x,verde:x,negro:x});
const INTRO=[
 "…¿Me oyes? Bien. No cuelgues. No te conviene.",
 "Antes de llegar a vuestra fiestecita de Halloween, vi cómo uno de vosotros mataba a una persona. A sangre fría. Sin temblar. Y sonreía.",
 "No pienso decir quién. Prefiero mirar cómo os miráis unos a otros.",
 "Soy… un poco especial. He escondido pistas por toda la casa. Cada una guarda una contraseña. Dádmela aquí y os regalaré un pedacito del asesino.",
 "Os aviso: voy a jugar con vosotros. Es lo único que me hace sentir vivo."];
const ST=[
 {i:["Mirad la pared. ¿La veis? Está llena de vuestras caras. Las fui pegando una a una, despacito, imaginando cuál sería la siguiente.",
     "Uno de esos rostros pertenece a un asesino. Y quién dice que el siguiente no seréis vosotros… Como dicen, nunca te fíes de un amigo."],
  q:["Y por si a alguno le pican las ganas de chivarse… decidme: ¿a quién deberíais llamar?"],
  p:A(["policia","la policia","112","091"]),
  ok:["Jajaja… qué lentos. Qué tiernos. A lo mejor esto os suena: miraos bien las caras. ¿Ya os las habéis mirado?","Pues el asesino… respira… ¡jajajaja! ¿De verdad pensabais que sería tan fácil?","No, no, no. Primero tenéis que demostrarme que puedo confiar en vosotros."]},
 {i:["¿No os habéis dado cuenta? Tenéis compañía en el jardín de atrás. Qué mala educación, no invitarlo a entrar.","Aunque a estas alturas ya le da igual. Ya no siente nada. Pero tiene un mensaje para vosotros."],
  p:A(["0000"]),
  ok:["Exacto. No hay nada como los buenos amigos en los que confiar.","Os noto cada vez más cerca. Huelo vuestro miedo desde aquí. Es delicioso.","Pero antes, vuestro despreciable amigo tiene una careta que quitarse, y yo le voy a ayudar. Basta con mirarlo a los ojos… porque marrón los veréis."],
  r:"Ojos marrones."},
 {i:["Qué caras de sospecha. Cómo se cruza la desconfianza entre vuestras miradas. ¿Lo veis? Así es mucho más divertido.","Qué noche de Halloween tan hermosa… Para calmar los ánimos, unos tragos nos vendrán bien, ¿no os parece?"],
  p:{rojo:["calabaza"],verde:["esqueleto"],negro:["titere","marioneta"]},
  ok:["Genial. Así me gusta. Estoy muy orgulloso de vosotros… casi me emociono.","La siguiente no será tan fácil. Pero antes, mirad su pelo. Castaño. Es el que vi mientras ocurría el asesinato. No pude apartar los ojos."],
  r:"Pelo castaño."},
 {i:["La siguiente está en el paso que une el jardín de delante con el de atrás. Os he dejado un regalito que descifrar. Uy, un pareado: soy todo un poeta.","Si lo resolvéis, estaréis más cerca de saber quién es el asesino. O más cerca de acabar como la pobre víctima."],
  p:A(["542316"]),
  h:"Cerca… pero aquí va un número. Los muertos no sangran letras.",
  ok:["Muy bien. Vuestro ritmo me da escalofríos… de los buenos.","Otro rasgo más, para que sigáis soñando conmigo: sus facciones, finas, en la nariz y los ojos. Y una piel pálida, como la de quien hace mucho que no ve la luz."],
  r:"Facciones finas en nariz y ojos, y piel pálida."},
 {i:["Esta vez no os haré ir lejos. Abajo, donde os gustará entrar. Donde reina la calma, al final de ese pasillo… en el SÓTANO. Allí os espera la siguiente pista. Disfrutadla."],
  p:{rojo:["gato"],verde:["comida"],negro:["naturaleza"]},
  ok:["Genial, genial. Vais perfectos. Si habéis llegado hasta aquí, tendré que daros algo bueno.","Mirad las caras de vuestros compañeros… porque podrían ser ellos. El asesino es el que durante todo este rato no ha parado de sonreír. ¿Os habéis fijado?"],
  r:"No ha parado de sonreír."}
];
const FINAL=["Entonces ya sabéis quién es, ¿verdad?"];
const NOMBRE=["tu","el narrador","narrador","desconocido"];
const ESPERA=20;
const FALLOS=["Nooo… esa no es. Qué lástima.","Jajaja, no. Seguid buscando, que me estoy divirtiendo.","Incorrecto. Alguien aquí está muy nervioso, lo noto.","Frío, frío… y no es por el Halloween."];
const EQ={rojo:"#c62a2f",verde:"#2f9e55",negro:"#3b3b44"};
/* ================================ */
const $=id=>document.getElementById(id),chat=$("chat"),bar=$("bar"),inp=$("inp");
const norm=s=>s.toLowerCase().normalize("NFD").replace(/[\u0300-\u036f]/g,"").replace(/[^a-z0-9 ]/g," ").replace(/\s+/g," ").trim();
const sleep=ms=>new Promise(r=>setTimeout(r,ms));
const fmt=ms=>{const d=new Date(ms);return d.toLocaleTimeString("es-ES",{hour12:false})+"."+String(d.getMilliseconds()).padStart(3,"0")};
if(location.hash==="#reiniciar"){try{localStorage.removeItem("fa2")}catch(e){}location.hash=""}
let S=null;try{S=JSON.parse(localStorage.getItem("fa2")||"null")}catch(e){}
if(!S)S={team:null,step:0,msgs:[],done:null,lock:0};
let busy=false;
const save=()=>{try{localStorage.setItem("fa2",JSON.stringify(S))}catch(e){}};
function draw(m){
 const d=document.createElement("div");d.className="m "+m.c;d.textContent=m.t;
 if(m.h){const b=document.createElement("b");b.textContent=m.h;d.appendChild(b)}
 chat.appendChild(d);chat.scrollTop=chat.scrollHeight;
}
function add(t,c,h){const m={t,c,h};S.msgs.push(m);save();draw(m)}
async function say(lines){
 busy=true;bar.hidden=true;
 for(const l0 of lines){
  const l=typeof l0==="string"?{t:l0}:l0;
  if(l.w){await sleep(l.w);continue}
  const ty=document.createElement("div");ty.className="m s";ty.textContent="Desconocido está escribiendo…";
  chat.appendChild(ty);chat.scrollTop=chat.scrollHeight;
  await sleep(900+Math.min(l.t.length*22,2400));
  ty.remove();add(l.t,l.c||"g");
 }
 busy=false;bar.hidden=!!S.done;if(!S.done)inp.focus();
}
function chip(){const c=$("chip");if(S.team){c.hidden=false;c.textContent=S.team.toUpperCase();c.style.background=EQ[S.team]}}
function intro(n){const s=ST[n];return [...s.i,...(s.t?[s.t[S.team]]:[]),...(s.q||[])]}
function picker(){
 const w=document.createElement("div");w.className="call";
 const im=document.createElement("img");im.src=$("av").src;im.alt="";w.appendChild(im);
 const p=document.createElement("div");p.className="pick";
 Object.keys(EQ).forEach(k=>{const b=document.createElement("button");b.textContent=k.toUpperCase();b.style.background=EQ[k];b.onclick=()=>{w.remove();start(k)};p.appendChild(b)});
 w.appendChild(p);chat.appendChild(w);
}
async function start(k){
 S.team=k;save();chip();add("Equipo "+k.toUpperCase(),"m u");
 await say([...INTRO,...intro(0)]);
}
async function submit(){
 if(busy||S.done||!S.team)return;
 const v=inp.value.trim();if(!v)return;inp.value="";
 add(v,"m u");
 const wait=Math.ceil((S.lock-Date.now())/1000);
 if(wait>0)return say(["Tranquilos. Esperad "+wait+" segundos antes de volver a intentarlo."]);
 if(S.step<ST.length){
  const s=ST[S.step];
  if(s.p[S.team].some(x=>norm(x)===norm(v))){
   const out=[...s.ok];
   if(s.r)out.push({t:s.r,c:"g r"});
   S.step++;save();
   out.push({w:9000},...(S.step<ST.length?intro(S.step):FINAL));
   await say(out);
  }else await say([s.h||FALLOS[Math.floor(Math.random()*FALLOS.length)]]);
 }else{
  if(NOMBRE.some(a=>norm(a)===norm(v))){
   S.done=Date.now();save();bar.hidden=true;
   await say(["…","Sí. Soy yo. Siempre fui yo."]);
   add("🏆 ¡Equipo "+S.team.toUpperCase()+", habéis descubierto al asesino!\nHora registrada:","m win",fmt(S.done));
   add("Enseñad esta pantalla y acudid dentro de casa.","m s");
   await say(["Todo este rato he estado jugando con vosotros. Me he divertido muchísimo. Gracias por el rato, de corazón.","Ya me despido, amigos. Ha sido divertido mientras ha durado.","Sed buenos… por esta noche."]);
   await vanish();
  }else{
   S.lock=Date.now()+ESPERA*1000;save();
   await say(["Ay, ay, ay… ese no es. Y ahora, pensadlo bien: "+ESPERA+" segundos de castigo."]);
  }
 }
}
function gone(){$("av").style.visibility="hidden";document.querySelector(".st").textContent="";document.body.classList.add("gone")}
async function vanish(){
 await sleep(6000);
 const a=$("av");
 for(let i=0;i<8;i++){a.style.opacity=i%2?1:.1;await sleep(130)}
 gone();
 S.msgs=S.msgs.filter(m=>m.c.includes("win"));S.gone=true;save();
 chat.querySelectorAll(".m").forEach(e=>{if(!e.classList.contains("win"))e.remove()});
}
$("go").onclick=submit;
inp.addEventListener("keydown",e=>{if(e.key==="Enter")submit()});
S.msgs.forEach(draw);chip();if(S.gone)gone();
if(!S.team){add("📞 Llamada entrante… Elegid vuestro equipo para contestar.","m s");picker()}
else if(!S.done)bar.hidden=false;
</script>
</body>
</html>
